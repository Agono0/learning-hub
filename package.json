{
  "name": "learning-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The research-backed self-learning system: FSRS spaced repetition, curriculum, motivation, addiction defense, ideas — all AI-agent accessible via MCP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "worker:deploy": "npm run worker:deploy -w @learning-hub/worker --if-present || (cd apps/worker && npx wrangler deploy)",
    "dev": "npm run dev --workspace @learning-hub/web",
    "build": "npm run build --workspace @learning-hub/web",
    "build:packages": "npm run build --workspace @learning-hub/core && npm run build --workspace @learning-hub/db && npm run build --workspace @learning-hub/cli",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "coverage": "npm run coverage --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:push": "npm run db:push --workspace @learning-hub/db",
    "db:seed": "npm run db:seed --workspace @learning-hub/db",
    "mcp": "tsx apps/mcp/src/index.ts",
    "cli": "tsx apps/cli/src/index.ts",
    "serve": "tsx apps/server/src/index.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/e2e/tsconfig.json",
    "app:dev": "npm run dev --workspace @learning-hub/native",
    "app:build": "npm run build --workspace @learning-hub/native",
    "android:dev": "node scripts/tauri-android.mjs dev",
    "android:build": "node scripts/tauri-android.mjs build --apk",
    "web:tauri": "node scripts/tauri-web.mjs build",
    "preview:tauri": "node scripts/serve-static.mjs apps/web/.next-tauri 4173",
    "new:feature": "node scripts/new-feature.mjs",
    "docs:curriculum": "tsx scripts/gen-curriculum-docs.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.48.1"
  },
  "overrides": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
