{
  "name": "@learning-hub/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learning HUB persistence layer: better-sqlite3 + drizzle-orm schema, review service and transaction helpers",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "better-sqlite3",
    "drizzle",
    "drizzle-orm",
    "learning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learning-hub/learning-hub.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@learning-hub/core": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.0"
  }
}
