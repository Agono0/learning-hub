{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "paths": {
      "@learning-hub/core": ["../../packages/core/src/index.ts"],
      "@learning-hub/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
