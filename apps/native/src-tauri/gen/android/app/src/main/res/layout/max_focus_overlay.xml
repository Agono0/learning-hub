<?xml version="1.0" encoding="utf-8"?>
<!-- Max Focus Tier 2 overlay content (M2-13): minimal banner on an opaque
     background — a visual backstop while the service returns focus, not a UI. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/overlay_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/overlay_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:textColor="#B8BFC9"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp" />
</LinearLayout>
