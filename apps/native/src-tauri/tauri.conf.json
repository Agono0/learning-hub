{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learning HUB",
  "version": "0.1.0",
  "identifier": "dev.learninghub.app",
  "build": {
    "beforeDevCommand": "node ../../scripts/tauri-web.mjs dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node ../../scripts/tauri-web.mjs build",
    "frontendDist": "../../web/.next-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Learning HUB",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "useHttpsScheme": false,
        "backgroundColor": "#0a0a0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "Research-backed self-learning system",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNUM1QjQxMkE2OTU1Q0IKUldUTFZXa3FRVnRjcXByMnkyUFQ3VE1VNXVTOUkwZ0lZQ0lqZVdBRVZnNmZmS040cFZtK1R2ZVEK",
      "endpoints": [
        "https://github.com/Agono0/learning-hub/releases/download/channel-pointers/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
