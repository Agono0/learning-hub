# ── Learning HUB environment variables ────────────────────────────────────────
# Copy this file to `.env` (never commit your real .env — it is git-ignored).
# Every value below is optional: the defaults in parentheses are used when the
# variable is unset, and `npm run dev` works with none of them set.

# Path of the SQLite database file. Default: resolved by walking up from the
# current directory to the repo root → <repo>/data/learning-hub.db.
# Point it anywhere (e.g. a separate volume or a test DB) — the parent directory
# is created automatically; the schema is created with `npm run db:push`.
# LEARNING_HUB_DB=./data/learning-hub.db

# Port for the headless REST server (`npm run serve`). Default: 3300.
# Malformed values fall back to the default with a warning (never crashes).
# The web app (`npm run dev`) is Next.js and always uses its own port (3000).
# LEARNING_HUB_PORT=3300

# Webhooks for the headless server: comma-separated `event=url` pairs. The
# server POSTs the event payload as JSON whenever a subscribed platform event
# fires (from the core event bus, e.g. review.completed, streak.broken,
# card.created, focus.completed — full catalog in docs/plugins.md). Delivery
# never blocks or fails the learning engine (3s timeout, failures logged only).
# LEARNING_HUB_WEBHOOKS=review.completed=http://127.0.0.1:8787/hook

# Optional extras (documented in docs/api-server.md):
# Bind host for the headless server — keep 127.0.0.1 unless you add an
# authenticating reverse proxy (there is NO auth on any endpoint).
# LEARNING_HUB_HOST=127.0.0.1

# ── Web Push Notifications (RFC 8292) ──────────────────────────────────────────
# Used by the web app and headless server for background study reminders.
# Generate a keypair with: `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=BK...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:learner@example.com

# ── Build Target Selectors ────────────────────────────────────────────────────
# Runtime target selector ('web' | 'tauri-windows' | 'tauri-android').
# Set automatically by packaging scripts (scripts/tauri-web.mjs, scripts/tauri-android.mjs).
# LEARNING_HUB_TARGET=web
# NEXT_PUBLIC_LEARNING_HUB_TARGET=web
