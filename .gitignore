# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Local data & secrets ────────────────────────────────────────────────────
data/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env*.local

# Signing material — never commit (Android keystores, Windows code signing,
# Tauri updater keys). Provide via CI secrets instead.
*.jks
*.keystore
key.properties
keystore.properties
*.p12
*.pfx
*.pem
*.key
!**/icons/**/*.key

# ── Web / TypeScript build output ───────────────────────────────────────────
.next/
out/
dist/
apps/extension/dist/
apps/worker/.wrangler/
*.tsbuildinfo
next-env.d.ts
apps/web/AGENTS.md
.eslintcache
coverage/
.vitest/
.turbo/

# ── Native (Tauri 2: Windows + Android) build output ───────────────────────
# Static export the native shell embeds + the vendored sqlite-wasm it serves.
apps/web/.next-tauri/
apps/web/public/vendor/
# Rust / Cargo
**/src-tauri/target/
# Regenerated by every Tauri build
**/src-tauri/gen/schemas/
# Android (the Gradle project in gen/android IS tracked; its build output
# is covered by its own .gitignore files — these are a safety net)
**/gen/android/**/build/
**/gen/android/**/.gradle/
**/gen/android/.tauri/
**/gen/android/app/src/main/jniLibs/
**/gen/android/app/src/main/assets/
**/gen/android/local.properties
.cxx/
.externalNativeBuild/
# Packaged installers / apps anywhere in the tree
*.apk
*.aab
*.msi
*.msix
*.appx
*-setup.exe

# ── Logs & OS / editor noise ────────────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Tooling ─────────────────────────────────────────────────────────────────
# husky internal (generated by prepare)
.husky/_/
# Claude Code machine-local config (launch servers, local permissions)
.claude/launch.json
.claude/settings.local.json

# ── Private / local-only directories — must never ship ──────────────────────
.agents/
.zcode/
math-333/

# ── Playwright (browser smoke) artifacts ───────────────────────────────────
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Extra safety nets ───────────────────────────────────────────────────────
# Environment variants (keep .env.example tracked)
.env.*
!.env.example
.dev.vars
# Package-manager / archive output
*.tgz
*.tar.gz
*.zip
# Extra local databases
*.sqlite
*.sqlite3
# Temp / backup files
*.tmp
*.bak
*.swp
# Next.js / Cloudflare / Rust extras
.next-*/
.vercel/
**/target/debug/
**/target/release/
# Local helper scripts
scripts/.commit-helper.sh
